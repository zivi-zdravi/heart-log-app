# Copy to .env (chmod 600). Never commit .env.
ANTHROPIC_API_KEY=sk-ant-...
# One per phone: name:passcode, comma-separated. Make each code with: openssl rand -hex 16
PASSCODES=katie:REPLACE_WITH_32_HEX,zoran:REPLACE_WITH_32_HEX
# Who may change the monthly limit from the app
ADMINS=katie,zoran
# Starting monthly limit in US dollars (the app can change it later)
MONTHLY_LIMIT_USD=10
